# Postgres connection string (Neon in production)
DATABASE_URL=postgres://user:password@localhost:5432/tap_chi_my_thuat
# Long random string used to sign auth tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Vercel Blob read/write token (media storage; leave empty to use local disk)
BLOB_READ_WRITE_TOKEN=
# Vercel deploy hook URL of the web project; triggers a rebuild when content is published
WEB_DEPLOY_HOOK_URL=
# Optional: public URL of this CMS (sets Payload serverURL)
PAYLOAD_PUBLIC_SERVER_URL=
# Seed script only
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
