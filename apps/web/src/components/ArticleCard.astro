---
import type { Article } from '../lib/types'
import TwoToneTitle from './TwoToneTitle.astro'
interface Props { article: Article; compact?: boolean }
const { article: a, compact = false } = Astro.props
---
<article class:list={['card', { 'card--compact': compact }]} data-testid="article-card">
  <a href={`/bai/${a.slug}`} class="card__link">
    <div class="card__media">
      {a.heroImage?.url
        ? <img src={a.heroImage.url} alt={a.heroImage.alt} width={a.heroImage.width} height={a.heroImage.height} loading={compact ? 'eager' : 'lazy'} />
        : <div class="card__placeholder" aria-hidden="true"></div>}
    </div>
    <TwoToneTitle title={a.title} accent={a.titleAccent} as="h3" size="md" />
    {!compact && a.sapo && <p class="card__sapo">{a.sapo}</p>}
  </a>
</article>
<style>
  .card__link { display: grid; gap: 8px; text-decoration: none; }
  .card__media img, .card__placeholder { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: var(--beige); }
  .card :global(.ttitle) { font-size: clamp(0.95rem, 0.9rem + 0.3vw, 1.15rem); line-height: 1.2; }
  .card__sapo { margin: 0; font-size: var(--step--1); color: var(--ink-soft); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card--compact :global(.ttitle) { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card__link:hover :global(.ttitle) { color: var(--orange-text); }
</style>
