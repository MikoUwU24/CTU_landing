---
import type { Article } from '../lib/types'
/**
 * variant="tile": image on top, title below (hero 2x2 grid).
 * variant="item": title, then small thumb left + excerpt right (main-column grid).
 */
interface Props { article: Article; variant?: 'tile' | 'item'; eager?: boolean }
const { article: a, variant = 'tile', eager = false } = Astro.props
const href = `/bai/${a.slug}`
---
<article class:list={['card', `card--${variant}`]} data-testid="article-card">
  {variant === 'tile' ? (
    <>
      <a href={href} class="card__media" tabindex="-1">
        {a.heroImage?.url
          ? <img src={a.heroImage.url} alt={a.heroImage.alt} width={a.heroImage.width} height={a.heroImage.height} loading={eager ? 'eager' : 'lazy'} />
          : <div class="card__ph thumb-ph"></div>}
      </a>
      <h3 class="card__title clamp-2"><a href={href}>{a.title}</a></h3>
    </>
  ) : (
    <>
      <h3 class="card__title clamp-2"><a href={href}>{a.title}</a></h3>
      <div class="card__row">
        <a href={href} class="card__thumb" tabindex="-1">
          {a.heroImage?.url
            ? <img src={a.heroImage.url} alt={a.heroImage.alt} width={a.heroImage.width} height={a.heroImage.height} loading="lazy" />
            : <div class="card__ph thumb-ph"></div>}
        </a>
        {a.sapo && <p class="card__sapo clamp-3">{a.sapo}</p>}
      </div>
    </>
  )}
</article>
<style>
  .card__media { display: block; }
  .card__media img, .card--tile .card__ph { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .card__title { font-size: 18.4px; font-weight: 400; line-height: 1.3; }
  .card--tile .card__title { margin-top: 12px; }

  .card--item { padding: 20px; }
  .card__row { display: grid; grid-template-columns: 142px minmax(0, 1fr); gap: 10px; margin-top: 10px; align-items: start; }
  .card__thumb img, .card--item .card__ph { width: 142px; height: 107px; object-fit: cover; }
  .card__sapo { margin: 0; font-size: 15px; line-height: 1.7; color: var(--ink); }
</style>
