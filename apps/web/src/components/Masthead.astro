---
import { getCurrentIssue } from '../lib/cms'
interface Props { compact?: boolean }
const { compact = false } = Astro.props
const issue = await getCurrentIssue()
---
<header class:list={['mh', { 'mh--compact': compact }]}>
  <img class="mh__cloud mh__cloud--top" src="/brand/cloud-top.webp" width="1143" height="551" alt="" aria-hidden="true" />
  <img class="mh__cloud mh__cloud--right" src="/brand/cloud-right.webp" width="706" height="396" alt="" aria-hidden="true" />
  <div class="wrap mh__inner">
    <a href="/" class="mh__logo" aria-label="Tạp chí Mỹ thuật — Trang chủ">
      <img src="/brand/masthead.webp" width="1349" height="711" alt="Tạp chí Mỹ thuật — Fine Arts Magazine" />
    </a>
    {issue && (
      <div class="mh__badge" aria-label={`Số ${issue.number}, kỳ ${issue.period}`}>
        <span class="mh__badge-label">Số</span>
        <span class="mh__badge-num">{issue.number}</span>
        <span class="mh__badge-period">{issue.period}</span>
      </div>
    )}
  </div>
  <nav class="mh__bar" aria-label="Chính">
    <div class="wrap mh__nav">
      <a href="/" class="mh__home" aria-label="Trang chủ">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 3 2 12h3v8h5v-6h4v6h5v-8h3z"/></svg>
      </a>
      <a href="/">Trang chủ</a>
      <a href="/muc-luc">Mục lục</a>
      <a href="/#loi-ngo">Lời ngỏ</a>
    </div>
  </nav>
</header>
<style>
  .mh { position: relative; overflow: hidden; padding-block: 24px 0; border-bottom: 3px double var(--maroon); }
  .mh__cloud { position: absolute; pointer-events: none; opacity: 0.9; height: auto; }
  .mh__cloud--top { top: -40px; left: -60px; width: min(55vw, 560px); }
  .mh__cloud--right { right: -80px; bottom: -30px; width: min(45vw, 460px); }
  .mh__inner { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .mh__logo img { height: auto; width: clamp(220px, 48vw, 520px); }
  .mh__badge {
    flex: none; width: clamp(76px, 12vw, 120px); aspect-ratio: 1; border-radius: 50%;
    border: 3px solid var(--maroon); display: grid; place-content: center; text-align: center; line-height: 1;
    color: var(--maroon); background: color-mix(in srgb, var(--cream) 85%, transparent);
  }
  .mh__badge-label { font-family: var(--font-display); font-size: 0.8em; text-transform: uppercase; }
  .mh__badge-num { font-family: var(--font-display); font-weight: 700; color: var(--orange); font-size: clamp(1.6rem, 4vw, 2.6rem); }
  .mh__badge-period { font-size: 0.7rem; margin-top: 2px; }
  .mh__bar { position: relative; margin-top: 16px; background: var(--maroon); }
  .mh__nav {
    display: flex; align-items: stretch; overflow-x: auto; scrollbar-width: none;
    font-family: var(--font-display); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; font-size: var(--step--1);
  }
  .mh__nav::-webkit-scrollbar { display: none; }
  .mh__nav a { flex: none; display: flex; align-items: center; padding: 12px 16px; text-decoration: none; color: var(--cream); white-space: nowrap; }
  .mh__nav a:hover { background: color-mix(in srgb, var(--cream) 14%, transparent); }
  .mh__nav .mh__home { background: var(--orange); color: #fff; padding-inline: 14px; }
  .mh__nav .mh__home:hover { background: var(--orange-text); }
  .mh--compact { padding-block: 12px 0; }
  .mh--compact .mh__logo img { height: auto; width: clamp(160px, 30vw, 300px); }
  .mh--compact .mh__badge { width: 84px; }
  .mh--compact .mh__badge-num { font-size: 1.5rem; }
  .mh--compact .mh__badge-period { font-size: 0.55rem; }
  .mh--compact .mh__badge-label { font-size: 0.65em; }
</style>
