---
import { getCurrentIssue, getMasthead } from '../lib/cms'
const m = await getMasthead()
const issue = await getCurrentIssue()
---
<footer class="ft" id="ban-bien-tap">
  <div class="wrap">
    <div class="ft__grid">
      <div class="ft__brand">
        <a href="/" aria-label="Tạp chí Mỹ thuật — Trang chủ">
          <img src="/brand/masthead.webp" width="1349" height="711" alt="Tạp chí Mỹ thuật" loading="lazy" />
        </a>
        {issue && <p class="ft__issue">Tạp chí Mỹ thuật số {issue.number}{issue.period && ` · ${issue.period}`}</p>}
      </div>
      <div class="ft__info">
        <p class="ft__head">Ban biên tập</p>
        {m.board.map((b) => (
          <p><strong>{b.role}:</strong> {b.names.map((n) => n.name).join(', ')}</p>
        ))}
        {m.publisher && <p><strong>Xuất bản:</strong> {m.publisher}</p>}
        {m.address && <p><strong>Địa chỉ:</strong> {m.address}</p>}
        {(m.phone || m.email) && (
          <p>
            {m.phone && <><strong>Điện thoại:</strong> {m.phone}</>}
            {m.phone && m.email && ' - '}
            {m.email && <><strong>Email:</strong> {m.email}</>}
          </p>
        )}
        {m.website && <p><strong>Website:</strong> {m.website}</p>}
        {m.coverCredit && <p class="ft__credit">{m.coverCredit}</p>}
      </div>
    </div>
  </div>
</footer>
<style>
  .ft { background: var(--footer-bg); padding-top: 0; padding-bottom: 30px; }
  .ft .wrap > .ft__grid { border-top: 1px solid #e5e5e5; padding-top: 50px; margin-top: 0; }
  .ft__grid { display: grid; gap: 24px; }
  .ft__brand { text-align: center; }
  .ft__brand img { width: 220px; margin-inline: auto; }
  .ft__issue { margin: 10px 0 0; font-size: 11.5px; font-weight: 700; color: var(--muted); line-height: 1.4; }
  .ft__info { font-size: 13px; line-height: 1.6; color: #555; }
  .ft__info p { margin: 0 0 3px; }
  .ft__info strong { color: #444; font-weight: 700; }
  .ft__head { font-weight: 700; text-transform: uppercase; color: #555; margin-bottom: 10px !important; }
  .ft__credit { font-style: italic; color: var(--muted); }
  @media (min-width: 850px) {
    .ft__grid { grid-template-columns: 290px minmax(0, 1fr); gap: 0; }
    .ft__info { border-left: 1px solid #e5e5e5; padding: 10px 0 30px 20px; }
  }
</style>
