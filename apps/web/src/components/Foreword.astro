---
import { getForeword } from '../lib/cms'
const f = await getForeword()
---
<section id="loi-ngo" class="fw" aria-labelledby="loi-ngo-title">
  <div class="wrap">
    <h2 id="loi-ngo-title" class="sec-title">{f.title}</h2>
    <div class="fw__body">
      {f.bodyHtml && <Fragment set:html={f.bodyHtml} />}
      {f.signature && <p class="fw__sig">{f.signature}</p>}
    </div>
  </div>
</section>
<style>
  .fw { background: var(--cream-block); padding-block: 50px 40px; margin-top: 50px; }
  .fw .sec-title { margin-bottom: 16px; }
  .fw__body { max-width: 900px; text-align: justify; }
  .fw__body :global(p) { margin: 0 0 1em; }
  .fw__sig { font-style: italic; text-align: right; }
</style>
