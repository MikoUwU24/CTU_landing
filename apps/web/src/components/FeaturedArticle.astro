---
import type { Article } from '../lib/types'
interface Props { article: Article }
const { article: a } = Astro.props
---
<article class="feat" data-testid="featured">
  <a href={`/bai/${a.slug}`} class="feat__media" tabindex="-1">
    {a.heroImage?.url
      ? <img src={a.heroImage.url} alt={a.heroImage.alt} width={a.heroImage.width} height={a.heroImage.height} loading="eager" fetchpriority="high" />
      : <div class="feat__ph thumb-ph"></div>}
  </a>
  <div class="feat__text">
    {a.kicker && <p class="feat__kicker">{a.kicker}</p>}
    <h2 class="feat__title"><a href={`/bai/${a.slug}`}>{a.title}</a></h2>
    {a.sapo && <p class="feat__sapo clamp-3">{a.sapo}</p>}
  </div>
</article>
<style>
  .feat__media { display: block; }
  .feat__media img, .feat__ph { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .feat__text { padding-top: 12px; }
  .feat__kicker { margin: 0 0 2px; font-size: 12.8px; text-transform: uppercase; color: var(--orange-text); font-weight: 500; }
  .feat__title { font-size: 18.4px; font-weight: 500; line-height: 1.3; }
  .feat__sapo { margin: 2px 0 0; color: var(--ink-soft); }
</style>
