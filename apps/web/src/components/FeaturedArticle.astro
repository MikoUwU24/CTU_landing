---
import type { Article } from '../lib/types'
import TwoToneTitle from './TwoToneTitle.astro'
interface Props { article: Article }
const { article: a } = Astro.props
---
<article class="feat" data-testid="featured">
  <a href={`/bai/${a.slug}`} class="feat__link">
    <div class="feat__media">
      {a.heroImage?.url
        ? <img src={a.heroImage.url} alt={a.heroImage.alt} width={a.heroImage.width} height={a.heroImage.height} loading="eager" fetchpriority="high" />
        : <div class="feat__placeholder" aria-hidden="true"></div>}
    </div>
    <div class="feat__text">
      <TwoToneTitle title={a.title} accent={a.titleAccent} kicker={a.kicker} as="h2" size="md" />
      {a.sapo && <p class="feat__sapo">{a.sapo}</p>}
    </div>
  </a>
</article>
<style>
  .feat__link { display: grid; gap: 12px; text-decoration: none; }
  .feat__media img, .feat__placeholder { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: var(--beige); }
  .feat__text :global(.ttitle) { font-size: clamp(1.3rem, 1.1rem + 0.9vw, 1.9rem); }
  .feat__sapo {
    margin: 8px 0 0; font-size: var(--step-0); line-height: 1.55; color: var(--ink-soft);
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .feat__link:hover :global(.ttitle) { color: var(--orange-text); }
</style>
