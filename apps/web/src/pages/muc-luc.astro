---
import Sidebar from '../components/Sidebar.astro'
import Base from '../layouts/Base.astro'
import { getArticles, getCurrentIssue } from '../lib/cms'
const articles = await getArticles()
const issue = await getCurrentIssue()
---
<Base title="Mục lục — Tạp chí Mỹ thuật">
  <div class="wrap layout">
    <div class="layout__main box">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Trang chủ</a> » <span aria-current="page">Mục lục</span></nav>
      <div class="toc">
        <h1 class="sec-title">{issue ? `Mục lục số ${issue.number} · ${issue.period}` : 'Mục lục'}</h1>
        <ol class="dash-list toc__list">
          {articles.map((a) => (
            <li data-testid="toc-item">
              <a href={`/bai/${a.slug}`} class="toc__title">{a.title}</a>
              {a.sapo && <p class="toc__sapo">{a.sapo}</p>}
            </li>
          ))}
        </ol>
      </div>
    </div>
    <Sidebar />
  </div>
</Base>
<style>
  .toc { padding: 20px 20px 30px; }
  .toc .sec-title { font-size: 20px; }
  .toc__list > li { padding: 12px 0; }
  .toc__title { font-size: 18px; line-height: 1.35; color: var(--ink); }
  .toc__title:hover { color: var(--orange-text); }
  .toc__sapo { margin: 4px 0 0; font-size: 14px; line-height: 1.55; color: var(--ink-soft); }
</style>
