---
import ArticleCard from '../components/ArticleCard.astro'
import FeaturedArticle from '../components/FeaturedArticle.astro'
import Foreword from '../components/Foreword.astro'
import Base from '../layouts/Base.astro'
import { getArticles, getCurrentIssue } from '../lib/cms'

const articles = await getArticles()
const issue = await getCurrentIssue()
const featured = articles.find((a) => a.featured) ?? articles[0]
const rest = articles.filter((a) => a !== featured)
const side = rest.slice(0, 4)
const more = rest.slice(4)
---
<Base title="Tạp chí Mỹ thuật — Fine Arts Magazine">
  <div class="wrap home">
    <h1 class="sr-only">{issue ? `Tạp chí Mỹ thuật số ${issue.number}` : 'Tạp chí Mỹ thuật'}</h1>
    <section class="lead" aria-label="Tin nổi bật">
      {featured && <div class="lead__main"><FeaturedArticle article={featured} /></div>}
      {side.length > 0 && (
        <div class="lead__side">
          {side.map((a) => <ArticleCard article={a} compact />)}
        </div>
      )}
    </section>
    {more.length > 0 && (
      <section aria-labelledby="trong-so-nay">
        <h2 id="trong-so-nay" class="home__h">Trong số này</h2>
        <div class="home__grid">
          {more.map((a) => <ArticleCard article={a} />)}
        </div>
      </section>
    )}
  </div>
  <Foreword />
</Base>
<style>
  .home { display: grid; gap: 40px; padding-top: 24px; padding-bottom: 16px; }
  .lead { display: grid; gap: 24px; }
  .lead__side { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 16px; align-content: start; }
  @media (min-width: 900px) {
    .lead { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; }
  }
  .home__h {
    font-size: var(--step-1); margin-bottom: 20px; padding-bottom: 8px;
    border-bottom: 2px solid var(--maroon);
  }
  .home__grid { display: grid; gap: 28px 20px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 900px) { .home__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
